{
  "rules": {
    ".read": false,
    ".write": false,
    "furo": {
      "scores": {
        ".read": true,
        ".indexOn": [
          "s"
        ],
        "$uid": {
          ".write": false,
          ".validate": "newData.hasChildren(['n', 's', 'c', 'f', 't', 'seed', 'v'])",
          "n": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
          },
          "x": {
            ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_]{0,15}$/)"
          },
          "s": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 500000 && newData.val() <= newData.parent().child('f').val() * 2.5"
          },
          "c": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5000"
          },
          "f": {
            ".validate": "newData.isNumber() && newData.val() >= 60 && newData.val() <= 216000"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "seed": {
            ".validate": "newData.isNumber()"
          },
          "v": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "replays": {
        "$uid": {
          ".read": true,
          ".write": false,
          ".validate": "newData.hasChildren(['seed', 'r', 'v'])",
          "seed": {
            ".validate": "newData.isNumber()"
          },
          "r": {
            ".validate": "newData.isString() && newData.val().length <= 200000"
          },
          "v": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "hidden": {
        ".read": true,
        "$uid": {
          ".write": "auth != null && auth.uid === root.child('furo_admin/uid').val()",
          ".validate": "newData.val() === true"
        }
      }
    },
